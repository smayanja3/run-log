<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
    <title>Signup Page</title>
</head>

<body>
    <header>
        <h2 class="logo">StrideLog</h2>
        <nav>
            <ul>
                <li><a href="/login"> Login</a></li> 
            </ul>
        </nav>
    </header>
    <main>
  <div>
        <h1>Welcome to StrideLog</h1>
        <p>Create an account to start tracking your runs</p>
 
        <% if( message.length === 0) { %>
            <p class="error"><%= message %></p>
       <% } %>

        <form action="/signup" method="POST">
            <label>Username
                <input type="text" name="username" placeholder="speedy_354">
            </label>
            <label>Email
                <input type="text" name="email" placeholder="example@example.com">
            </label>
            <!-- have to make password type password so its not viable -->
            <label>Password
                <input type="password" name="password"  minlength="8" placeholder="*************">
            </label>
            <button type="submit">Register</button>
        </form>
        <p>Already have an account?<a href="/login"> Sign in</a></p>
    </div>
    </main>
</body>

</html>