<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>My Running Stats</title>
</head>

<body>
    <header>
        <h2 class="logo">Stride<span>Log</span></h2>
        <nav>
            <ul>
                <li><a href="/runs"> Run</a></li>
                <li><a href="/runs/new"> Log a Run</a></li>
                <li><a href="/logout"> Sign Out</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1>My running stats</h1>

       <% if(runs.length === 0) { %>
        <p>No runs yet.<a href="/runs/new">Log your first run</a></p>
      <% } else { %> 
    
        <div class="headstat">
            <p class="label">Total miles</p>
            <p><%= stats.totalMiles %></p>
            <p>across <%= stats.totalRuns %> runs</p>
        </div>

        <div class="gridStats">
            <div class="stat"><p class="label">Avg pace</p><p class="val"><%= stats.avgPace  %></p></div>
            <div class="stat"><p class="label"></p>Fastest pace<p class="val"><%= stats.fastestPace %></p></div>
            <div class="stat"><p class="label"></p> Longest run<p class="val"><%=stats.longest  %></p></div>
            <div class="stat"><p class="label"></p>Total time<p class="val"><%= stats.totalTime %></p></div>
        </div>    
<!-- for (const feel in feels) {  runs once for each key in the feild object}
 cant write feels.feel becasue it looks for an key with that name -->
        <section>
            <h3>How runs felt</h3>
            <div class="feels">
                <!-- creats the array of feels -->
               <% const feelNames = Object.keys(feels) %>
               <% for( let i = 0; i < feelNames.length; i++) { %>
                    <span class="feel <%= feelNames[i] %>"><%= feelNames[i] %> x <%= feels[feelNames[i]] %></span>
              <%  } %>
            </div>
        </section>
   <% } %>

    </main>
    <script src="/js/main.js"></script>
</body>

</html>