<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/add.css">
    <title>Log New Run</title>
</head>

<body>
    <header>
        <h2 class="logo">Stride<span>Log</span></h2>
        <nav>
            <ul>
                <li><a href="/profile"> Profile</a></li>
                <li><a href="/runs"> Runs</a></li>
                <li><a href="/logout"> Sign Out</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h2> New Activity</h2>
        <form action="/runs" method="POST">
            <div id="formBox">
                <div id="formTop">
                    <label id="formDate">Date<input type="date" name="date" required></label>
                    <!-- add steps to get the second value point for my distance -->
                    <label>Distance (miles)<input type="number" name="distance" min="0.1" step="0.01" placeholder="3.27"
                            required></label>
                </div>

                <label>Route<input type="text" name="route" placeholder="Charles River"></label>

                <!-- have to split the time by min and sec for conversion -->
                <p>Time (minutes)</p>
                <section class="timeInput">
                    <label>Hours<input type="number" name="hours" min="1" placeholder="2"></label>
                    <label>Minutes<input type="number" name="minutes" min="0" placeholder="47" required></label>
                    <!-- do i need value=0 to the times? -->
                    <label>Seconds<input type="number" name="seconds" min="0" max="59" placeholder="34"
                            required></label>
                    </section>

                <div id="formBottom">
                    <label for="feel">Feeling</label>
                    <select name="feel" id="feel">
                        <option value="strong">Strong</option>
                        <option value="great">Great</option>
                        <option value="okay">Okay</option>
                        <option value="drained">Drained</option>
                        <option value="balanced">Balanced</option>
                    </select>
                    <label>Rating(1-10)<input type="number" name="rating" min='1' max="10"
                            placeholder="optional"></label>
                </div>

                <label>Notes<textarea name="notes"></textarea></label>
                <div id="actions">
                    <button type="submit" class="btn">Add Run</button>
                    <a href="/runs" id="cancel" class="btn">Cancel</a>
                </div> 
            </div>
        </form>
    </main>

</body>

</html>